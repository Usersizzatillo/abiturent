# Django / backend
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
# Ishga tushirishdan oldin real qiymat bilan almashtiring!
DJANGO_ALLOWED_HOSTS=abituriyent.orgtrace.uz,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://abituriyent.orgtrace.uz,http://localhost:3000,http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=https://abituriyent.orgtrace.uz,http://localhost:3000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database (docker-compose ichida host=db; lokal rivojlantirishda localhost)
POSTGRES_DB=abiturend
POSTGRES_USER=abiturend
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=https://abituriyent.orgtrace.uz

# Telegram bot (admin bildirishnomalar)
# Token: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Admin chat id: @userinfobot orqali topiladi
TELEGRAM_CHAT_ID=
# Qo'shimcha ruxsat etilgan chat id'lar (vergul bilan)
TELEGRAM_ALLOWED_CHAT_IDS=
# Webhook xavfsizlik kaliti (o'zingiz ixtiyoriy token tanlang)
TELEGRAM_WEBHOOK_SECRET=
# Webhook xost (masalan: abituriyent.orgtrace.uz)
TELEGRAM_WEBHOOK_HOST=

# MCP bridge (/mcp/) — MAJBURIY
# Bridge backend'dagi savol bankini (javoblar bilan) chiqaradi, shuning uchun
# autentifikatsiyasiz so'rovlarni RAD qiladi. Kalitni yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# So'rov header'i:  Authorization: Bearer <MCP_API_KEY>
# Bo'sh qoldirilMAYDI: docker compose bo'sh qiymatni qabul qilmaydi va ishga
# tushmaydi. Bridge darhol 503 bilan hamma so'rovni rad etadi (fail-closed).
MCP_API_KEY=
# Qo'shimcha kalit: include_answers=true (to'g'ri javob/izoh) faqat shu kalit
# bilan ishlaydi. Bo'sh qoldirilsa javoblar hech qachon ochilmaydi.
MCP_ADMIN_API_KEY=